---
// Project write-ups moved into modals on the homepage. These stubs keep old
// /projects/<slug>/ links (resume, LinkedIn, search results) working.
import { getCollection } from 'astro:content';
import { projectHref } from '../../lib/projectLinks';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const target = projectHref(project.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{project.data.title} - Harrison Saperstein</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`https://hksaperstein.github.io${target}`} />
  </head>
  <body>
    <a href={target}>Redirecting to {project.data.title}…</a>
  </body>
</html>
