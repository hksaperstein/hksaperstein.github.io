---
import { TOOLS, MODELS, LANGUAGES } from '../data/tools';
---

<section id="skills" class="border-t border-line">
  <div class="reveal mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-2xl font-bold tracking-tight">Tools & Frameworks</h2>
    <p class="mt-2 text-muted">What I reach for, and what I've actually built with it.</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        TOOLS.map((tool) =>
          tool.project ? (
            <a
              href={tool.project}
              class="group rounded-2xl border border-line bg-card p-5 transition-transform duration-150 hover:-translate-y-0.5 hover:border-accent motion-reduce:transition-none motion-reduce:hover:translate-y-0"
            >
              <h3 class="font-semibold tracking-tight group-hover:text-accent">{tool.name}</h3>
              <p class="mt-2 text-sm text-muted">{tool.how}</p>
              <span class="mt-3 inline-block text-sm font-medium text-accent group-hover:underline">See it in a project →</span>
            </a>
          ) : (
            <div class="rounded-2xl border border-line bg-card p-5">
              <h3 class="font-semibold tracking-tight">{tool.name}</h3>
              <p class="mt-2 text-sm text-muted">{tool.how}</p>
            </div>
          )
        )
      }
    </div>

    <p class="mt-10 text-xs font-medium tracking-widest text-muted uppercase">Models & Methods</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {MODELS.map((model) => (
        <span class="rounded-full border border-accent/30 bg-card px-2.5 py-0.5 text-sm text-muted">{model}</span>
      ))}
    </div>

    <p class="mt-8 text-xs font-medium tracking-widest text-muted uppercase">Languages & Environments</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {LANGUAGES.map((language) => (
        <span class="rounded-full border border-accent/30 bg-card px-2.5 py-0.5 text-sm text-muted">{language}</span>
      ))}
    </div>
  </div>
</section>
