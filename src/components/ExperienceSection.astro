---
import { SITE } from '../data/site';

const stats = [
  { value: '5', label: 'years in surgical robotics' },
  { value: 'MS + BS', label: 'Robotics Engineering at WPI' },
  { value: '15+', label: 'manual processes automated' },
  { value: 'WEEKS → DAYS', label: 'per verification cycle', wide: true },
];
---

<section id="experience" class="scroll-mt-16 border-t border-line">
  <div class="reveal mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-2xl font-bold tracking-tight">Experience</h2>

    <div class="mt-10 grid grid-cols-1 gap-y-6 text-center sm:grid-cols-2 sm:gap-x-8 sm:gap-y-8 sm:text-left lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class={stat.wide ? 'sm:col-span-2 lg:col-span-1' : ''}>
            <p class="text-2xl font-bold tracking-tight whitespace-nowrap sm:text-3xl">{stat.value}</p>
            <p class="mt-1 text-sm text-muted">{stat.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 space-y-8">
      <div>
        <div class="flex flex-wrap items-baseline justify-between">
          <strong class="font-semibold tracking-tight">Medtronic - Hugo RAS</strong>
          <span class="text-sm text-muted">Boston, MA · Aug 2021 - Present</span>
        </div>
        <div class="mt-2 space-y-4">
          <div>
            <p><span class="font-medium text-accent">Senior Software Verification Engineer</span><span class="text-sm text-muted"> · July 2024 - Present</span></p>
            <p class="mt-1 text-sm text-muted">
              Hugo is Medtronic's robotic-assisted surgery platform. I architect the automated
              testing frameworks that verify it. I migrated legacy manual processes to automated
              pipelines and built the Python tooling that cut verification cycles from weeks to
              days. I work with systems teams to turn requirements into testable protocols, and
              mentor other engineers on automation and troubleshooting.
            </p>
          </div>
          <div>
            <p><span class="font-medium text-fg">Software Verification Engineer II</span><span class="text-sm text-muted"> · Aug 2021 - July 2024</span></p>
            <p class="mt-1 text-sm text-muted">
              I built the team's automated test framework - Python and Squish - for real-time UI
              verification. I converted 15+ manual test processes to automated ones and developed
              the system-in-loop and software-in-loop verification protocols.
            </p>
          </div>
        </div>
      </div>

      <div>
        <div class="flex flex-wrap items-baseline justify-between">
          <strong class="font-semibold tracking-tight">Hubbell Inc. - Research and Development</strong>
          <span class="text-sm text-muted">Avon, CT · May 2019 - Apr 2021</span>
        </div>
        <div class="mt-2">
          <p><span class="font-medium text-fg">Machine Learning Intern</span></p>
          <p class="mt-1 text-sm text-muted">
            I built a real-time object detection system for video streams. Motion detection ran
            in OpenCV, the detection models were TensorFlow with TensorRT acceleration to keep
            inference real-time, and a cloud pipeline handled the training data.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-10">
      <p class="text-sm text-muted">WPI - MS Robotics Engineering '21 · BS Robotics Engineering '20</p>
      <a
        href={SITE.resume}
        download={SITE.resumeFilename}
        class="mt-6 inline-block rounded-md bg-accent px-4 py-2 font-medium text-white transition-opacity hover:opacity-90"
      >Download resume</a>
    </div>
  </div>
</section>
