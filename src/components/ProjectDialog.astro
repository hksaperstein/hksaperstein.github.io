---
// Full project write-up rendered as a modal on the homepage. Each project gets
// exactly one dialog; any link to `/#<slug>` opens it (see script below).
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Gallery from './Gallery.astro';
import TrainingCurves from './TrainingCurves.astro';
import ModelsSection from './ModelsSection.astro';
import SchematicsSection from './SchematicsSection.astro';
import ComponentsSection from './ComponentsSection.astro';
import { projectDialogId } from '../lib/projectLinks';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;

const gallery = data.gallery ?? [];
const heroMedia = data.featured_image ?? gallery[0]?.file;
const heroIsVideo = heroMedia ? /\.(mp4|webm|mov)$/i.test(heroMedia) : false;

const externalLinks = [
  { url: data.github_url, label: 'GitHub' },
  { url: data.thingiverse_url, label: 'Thingiverse' },
  { url: data.demo_url, label: 'Demo' },
].filter((link) => link.url && link.url !== '#');

const formattedDate = data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
const tools = data.preview?.tools;
---

<dialog
  id={projectDialogId(project.id)}
  data-project-dialog={project.id}
  aria-labelledby={`${projectDialogId(project.id)}-title`}
  class="project-dialog m-auto w-[calc(100vw-1.5rem)] max-w-3xl overflow-hidden rounded-2xl border border-line bg-card p-0 text-fg"
>
  <button
    type="button"
    data-dialog-close
    aria-label="Close"
    class="absolute top-3 right-3 z-20 rounded-full bg-bg/70 p-1.5 text-muted backdrop-blur transition-colors hover:text-fg"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </button>

  <div class="max-h-[calc(100dvh-1.5rem)] overflow-y-auto overscroll-contain">
    {
      heroMedia &&
        (heroIsVideo ? (
          <video controls muted playsinline preload="none" class="aspect-video w-full bg-bg object-cover" src={heroMedia} />
        ) : (
          <img src={heroMedia} alt={data.title} loading="lazy" class="aspect-video w-full bg-bg object-cover" />
        ))
    }

    <article class="px-6 py-8 sm:px-10 sm:py-10">
      <header>
        <div class="flex flex-wrap gap-2">
          {data.categories.map((category) => (
            <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{category}</span>
          ))}
        </div>
        <h2 id={`${projectDialogId(project.id)}-title`} class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{data.title}</h2>
        <p class="mt-3 text-lg text-muted">{data.description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-muted">
          <time datetime={data.date.toISOString().slice(0, 10)}>{formattedDate}</time>
          {externalLinks.map((link) =>
            link.label === 'GitHub' ? (
              <a href={link.url} aria-label="GitHub" class="text-accent transition-colors hover:text-fg">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </a>
            ) : (
              <a href={link.url} class="font-medium text-accent hover:underline">{link.label} ↗</a>
            )
          )}
        </div>
        {tools && tools.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {tools.map((tool) => (
              <span class="rounded-full border border-accent/30 bg-bg px-2.5 py-0.5 text-xs text-muted">{tool}</span>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-stone dark:prose-invert mt-10 max-w-none">
        <Content />
      </div>

      {data.training_curves && <TrainingCurves title={data.training_curves_title} />}
      {gallery.length > 0 && <Gallery items={gallery} title={data.gallery_title} intro={data.gallery_intro} />}
      {data.models && data.models.length > 0 && <ModelsSection items={data.models} />}
      {data.schematics && data.schematics.length > 0 && <SchematicsSection items={data.schematics} />}
      {data.components && data.components.length > 0 && <ComponentsSection items={data.components} />}
    </article>
  </div>
</dialog>

<style>
  .project-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
</style>

<script>
  // One script for every project dialog. The URL hash (`#<slug>`) is the source
  // of truth: opening pushes it, Back pops it and closes the dialog, and a
  // shared link like /#dice-detection opens straight into that project.
  const dialogs = new Map<string, HTMLDialogElement>();
  document.querySelectorAll<HTMLDialogElement>('dialog[data-project-dialog]').forEach((d) => {
    dialogs.set(d.dataset.projectDialog!, d);
  });

  let pushedSlug: string | null = null; // slug whose hash entry we added to history

  const slugFromHash = (hash: string) => decodeURIComponent(hash.replace(/^#/, ''));
  const openDialog = () => [...dialogs.values()].find((d) => d.open);
  const clearHash = () => history.replaceState(history.state, '', location.pathname + location.search);

  function open(slug: string, { fromHistory = false } = {}) {
    const dialog = dialogs.get(slug);
    if (!dialog || dialog.open) return;

    const current = openDialog();
    current?.close();

    if (!fromHistory && location.hash !== `#${slug}`) {
      if (current) {
        history.replaceState(history.state, '', `#${slug}`);
      } else {
        history.pushState(history.state, '', `#${slug}`);
      }
      pushedSlug = slug;
    } else if (!current) {
      pushedSlug = null;
    }

    // Videos stay unloaded until their dialog is opened.
    dialog.querySelectorAll('video[preload="none"]').forEach((v) => v.setAttribute('preload', 'metadata'));
    dialog.showModal();
    dialog.querySelector<HTMLElement>('.overflow-y-auto')?.scrollTo(0, 0);
    document.documentElement.classList.add('overflow-hidden');
  }

  for (const [slug, dialog] of dialogs) {
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      dialog.querySelectorAll('video').forEach((v) => v.pause());
      // The close event fires a task later, so when switching projects the next
      // dialog is already open here and owns the hash and the scroll lock.
      if (openDialog()) return;
      document.documentElement.classList.remove('overflow-hidden');
      if (location.hash === `#${slug}`) {
        if (pushedSlug === slug) {
          pushedSlug = null;
          history.back();
        } else {
          clearHash();
        }
      }
    });
  }

  // Any same-page link to a project hash opens its dialog: project cards, tool
  // cards, and cross-links inside write-ups.
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
    if (!link) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname) return;
    const slug = slugFromHash(url.hash);
    if (!dialogs.has(slug)) return;
    event.preventDefault();
    open(slug);
  });

  window.addEventListener('popstate', () => {
    const slug = slugFromHash(location.hash);
    if (dialogs.has(slug)) {
      open(slug, { fromHistory: true });
    } else {
      const current = openDialog();
      if (current) {
        pushedSlug = null; // history already moved; don't go back again
        current.close();
      }
    }
  });

  const initial = slugFromHash(location.hash);
  if (dialogs.has(initial)) open(initial, { fromHistory: true });
</script>
