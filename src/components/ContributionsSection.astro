---
type Day = { date: string; level: number; count: number | null };

const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const REPO = 'hksaperstein/rl';
const REPO_URL = `https://github.com/${REPO}`;

let weeks: Day[][] = [];
let monthLabels: string[] = [];
let total: string | null = null;

try {
  const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'hksaperstein.github.io-build',
  };
  const token = process.env.GITHUB_TOKEN;
  if (token) {
    headers.Authorization = `Bearer ${token}`;
  }

  // GitHub computes stats asynchronously: a 202 means "try again shortly".
  let statsData: Array<{ week: number; total: number; days: number[] }> | null = null;
  for (let attempt = 0; attempt < 5; attempt++) {
    const res = await fetch(`https://api.github.com/repos/${REPO}/stats/commit_activity`, { headers });
    if (res.status === 202) {
      await new Promise((resolve) => setTimeout(resolve, 2000));
      continue;
    }
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data) && data.length) {
        statsData = data;
      }
    }
    break;
  }

  if (statsData) {
    const now = new Date();
    const todayUTC = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());

    let allWeeks: Day[][] = [];
    for (const weekEntry of statsData) {
      const weekStartMs = weekEntry.week * 1000;
      const week: Day[] = [];
      for (let d = 0; d < 7; d++) {
        const dayMs = weekStartMs + d * 86400000;
        if (dayMs > todayUTC) {
          // current week is partial - keep the placeholder so the last column trails off
          week.push({ date: '', level: -1, count: null });
          continue;
        }
        const dayDate = new Date(dayMs);
        const dateStr = dayDate.toISOString().slice(0, 10);
        const count = weekEntry.days?.[d] ?? 0;
        week.push({ date: dateStr, level: 0, count });
      }
      allWeeks.push(week);
    }

    weeks = allWeeks.slice(-6);

    if (weeks.length) {
      const realDays = weeks.flat().filter((d) => d.level !== -1);
      const max = realDays.reduce((acc, d) => Math.max(acc, d.count ?? 0), 0);

      for (const day of realDays) {
        const count = day.count ?? 0;
        if (count === 0) {
          day.level = 0;
        } else if (max > 0) {
          day.level = Math.min(4, Math.max(1, Math.ceil((count / max) * 4)));
        } else {
          day.level = 0;
        }
      }

      let lastMonth = -1;
      monthLabels = weeks.map((week) => {
        const firstReal = week.find((d) => d.level !== -1);
        if (!firstReal) return '';
        const month = parseInt(firstReal.date.slice(5, 7), 10) - 1;
        if (month !== lastMonth) {
          lastMonth = month;
          return MONTH_NAMES[month];
        }
        return '';
      });

      if (realDays.length) {
        const sum = realDays.reduce((acc, d) => acc + (d.count ?? 0), 0);
        total = String(sum);
      }
    }
  }
} catch {
  weeks = [];
  monthLabels = [];
  total = null;
}
---

{
  weeks.length > 0 && (
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-5xl px-6 py-20">
        <div class="mx-auto w-max max-w-full overflow-x-auto rounded-2xl border border-line bg-card p-6">
          <h2 class="text-2xl font-bold tracking-tight">Agentic Team Contributions</h2>
          <div class="mx-auto mt-6 w-max">
            <div class="flex gap-[4px]">
              {monthLabels.map((label) => (
                <div class="w-6 shrink-0 text-xs whitespace-nowrap text-muted">{label}</div>
              ))}
            </div>
            <div class="mt-1 flex gap-[4px]">
              {weeks.map((week) => (
                <div class="flex flex-col gap-[4px]">
                  {week.map((day) =>
                    day.level === -1 ? (
                      <span class="h-6 w-6" />
                    ) : (
                      <span
                        class={`h-6 w-6 rounded-[4px] l${day.level}`}
                        title={`${day.count ?? 0} contributions on ${day.date}`}
                      />
                    )
                  )}
                </div>
              ))}
            </div>
            <div class="mt-3 text-right">
              <a
                href={REPO_URL}
                class="text-sm text-muted hover:text-accent hover:underline"
              >hksaperstein/rl</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .l0 {
    background-color: var(--line);
  }
  .l1 {
    background-color: color-mix(in oklab, var(--accent) 30%, var(--bg));
  }
  .l2 {
    background-color: color-mix(in oklab, var(--accent) 55%, var(--bg));
  }
  .l3 {
    background-color: color-mix(in oklab, var(--accent) 80%, var(--bg));
  }
  .l4 {
    background-color: var(--accent);
  }
</style>
