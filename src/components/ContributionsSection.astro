---
type Day = { date: string; level: number; count: number | null };
type StatsWeek = { week: number; total: number; days: number[] };
type Card = {
  repoUrl: string;
  repoName: string;
  label: string;
  weeks: Day[][];
  monthLabels: string[];
  total: string | null;
};

const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const REPOS = [
  { repo: 'hksaperstein/rl', label: 'RL manipulation platform' },
  { repo: 'hksaperstein/hksaperstein.github.io', label: 'Portfolio' },
];

const headers: Record<string, string> = {
  Accept: 'application/vnd.github+json',
  'User-Agent': 'hksaperstein.github.io-build',
};
const token = process.env.GITHUB_TOKEN;
if (token) {
  headers.Authorization = `Bearer ${token}`;
}

// GitHub computes stats asynchronously: a 202 means "try again shortly".
async function fetchCommitActivity(repo: string): Promise<StatsWeek[] | null> {
  try {
    for (let attempt = 0; attempt < 5; attempt++) {
      const res = await fetch(`https://api.github.com/repos/${repo}/stats/commit_activity`, { headers });
      if (res.status === 202) {
        await new Promise((resolve) => setTimeout(resolve, 2000));
        continue;
      }
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data) && data.length) return data;
      }
      return null;
    }
    return null;
  } catch {
    return null;
  }
}

function buildCard(repo: string, label: string, statsData: StatsWeek[] | null): Card | null {
  if (!statsData) return null;
  try {
    const now = new Date();
    const todayUTC = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());

    const allWeeks: Day[][] = [];
    for (const weekEntry of statsData) {
      const weekStartMs = weekEntry.week * 1000;
      const week: Day[] = [];
      for (let d = 0; d < 7; d++) {
        const dayMs = weekStartMs + d * 86400000;
        if (dayMs > todayUTC) {
          // current week is partial - keep the placeholder so the last column trails off
          week.push({ date: '', level: -1, count: null });
          continue;
        }
        const dateStr = new Date(dayMs).toISOString().slice(0, 10);
        const count = weekEntry.days?.[d] ?? 0;
        week.push({ date: dateStr, level: 0, count });
      }
      allWeeks.push(week);
    }

    const weeks = allWeeks.slice(-6);
    if (!weeks.length) return null;

    const realDays = weeks.flat().filter((d) => d.level !== -1);
    const max = realDays.reduce((acc, d) => Math.max(acc, d.count ?? 0), 0);
    for (const day of realDays) {
      const count = day.count ?? 0;
      if (count === 0 || max === 0) {
        day.level = 0;
      } else {
        day.level = Math.min(4, Math.max(1, Math.ceil((count / max) * 4)));
      }
    }

    let lastMonth = -1;
    const monthLabels = weeks.map((week) => {
      const firstReal = week.find((d) => d.level !== -1);
      if (!firstReal) return '';
      const month = parseInt(firstReal.date.slice(5, 7), 10) - 1;
      if (month !== lastMonth) {
        lastMonth = month;
        return MONTH_NAMES[month];
      }
      return '';
    });

    const total = realDays.length ? String(realDays.reduce((acc, d) => acc + (d.count ?? 0), 0)) : null;

    return {
      repoUrl: `https://github.com/${repo}`,
      repoName: repo,
      label,
      weeks,
      monthLabels,
      total,
    };
  } catch {
    return null;
  }
}

let cards: Card[] = [];
try {
  const results = await Promise.all(REPOS.map((r) => fetchCommitActivity(r.repo)));
  cards = REPOS.map((r, i) => buildCard(r.repo, r.label, results[i])).filter((c): c is Card => c !== null);
} catch {
  cards = [];
}
---

{
  cards.length > 0 && (
    <section class="border-t border-line">
      <div class="reveal mx-auto max-w-5xl px-6 py-20">
        <div id="contributions-carousel">
          <div class="relative">
            {cards.length > 1 && (
              <button
                type="button"
                class="absolute left-0 top-1/2 z-10 hidden -translate-y-1/2 text-muted transition-colors hover:text-fg sm:flex"
                aria-label="Previous repo"
                data-carousel-prev
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
            )}

            <div class="scrollbar-hide overflow-x-auto" data-carousel-scroll>
              <div class="flex snap-x snap-mandatory" data-carousel-track data-real-count={cards.length}>
                {(cards.length > 1 ? [cards[cards.length - 1], ...cards, cards[0]] : cards).map((card) => (
                  <div class="flex w-full shrink-0 snap-center justify-center px-1">
                    <div class="flex w-full max-w-md flex-col rounded-2xl border border-line bg-card p-6">
                      <p class="text-xs font-medium tracking-widest text-muted uppercase">Agentic Team Contributions</p>
                      <h2 class="mt-1 text-2xl font-bold tracking-tight">{card.label}</h2>
                      {card.total && <p class="mt-2 text-muted">{card.total} contributions in the last 6 weeks</p>}

                      <div class="mx-auto mt-6 w-max">
                        <div class="flex gap-[4px]">
                          {card.monthLabels.map((label) => (
                            <div class="w-6 shrink-0 text-xs whitespace-nowrap text-muted">{label}</div>
                          ))}
                        </div>
                        <div class="mt-1 flex gap-[4px]">
                          {card.weeks.map((week) => (
                            <div class="flex flex-col gap-[4px]">
                              {week.map((day) =>
                                day.level === -1 ? (
                                  <span class="h-6 w-6" />
                                ) : (
                                  <span
                                    class={`h-6 w-6 rounded-[4px] l${day.level}`}
                                    title={`${day.count ?? 0} contributions on ${day.date}`}
                                  />
                                )
                              )}
                            </div>
                          ))}
                        </div>
                      </div>

                      <div class="mt-auto flex justify-end pt-3">
                        <a href={card.repoUrl} aria-label={`${card.repoName} on GitHub`} title={card.repoName} class="text-muted transition-colors hover:text-accent">
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                        </a>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {cards.length > 1 && (
              <button
                type="button"
                class="absolute right-0 top-1/2 z-10 hidden -translate-y-1/2 text-muted transition-colors hover:text-fg sm:flex"
                aria-label="Next repo"
                data-carousel-next
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            )}
          </div>

          {cards.length > 1 && (
            <div class="mt-4 flex justify-center gap-2" data-carousel-dots>
              {cards.map((_, i) => (
                <button
                  type="button"
                  class="h-2 w-2 rounded-full bg-line transition-colors"
                  aria-label={`Go to repo ${i + 1} of ${cards.length}`}
                  data-carousel-dot
                  data-index={i}
                />
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .l0 {
    background-color: var(--line);
  }
  .l1 {
    background-color: color-mix(in oklab, var(--accent) 30%, var(--bg));
  }
  .l2 {
    background-color: color-mix(in oklab, var(--accent) 55%, var(--bg));
  }
  .l3 {
    background-color: color-mix(in oklab, var(--accent) 80%, var(--bg));
  }
  .l4 {
    background-color: var(--accent);
  }

  .scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

</style>

<script>
  const root = document.getElementById('contributions-carousel');

  if (root) {
    const scrollEl = root.querySelector('[data-carousel-scroll]');
    const track = root.querySelector('[data-carousel-track]');
    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    const dots = Array.from(root.querySelectorAll('[data-carousel-dot]'));
    const slides = track ? Array.from(track.children) : [];

    if (scrollEl instanceof HTMLElement && track instanceof HTMLElement && slides.length > 0) {
      // with more than one card the track is [cloneOfLast, ...real, cloneOfFirst],
      // so arrows always animate in their own direction and wrap seamlessly
      const realCount = parseInt(track.dataset.realCount ?? String(slides.length), 10);
      const hasClones = slides.length !== realCount;
      const offset = hasClones ? 1 : 0;

      const width = () => scrollEl.clientWidth;
      const visualIndex = () => Math.round(scrollEl.scrollLeft / width());

      const setActive = (real: number) => {
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-accent', i === real);
          dot.classList.toggle('bg-line', i !== real);
        });
      };

      const realFromVisual = (visual: number) => (((visual - offset) % realCount) + realCount) % realCount;

      const scrollToVisual = (visual: number, smooth = true) => {
        // dots lead the slide: update the indicator as the motion starts
        setActive(realFromVisual(visual));
        scrollEl.scrollTo({ left: visual * width(), behavior: smooth ? 'smooth' : 'auto' });
      };

      prevBtn?.addEventListener('click', () => scrollToVisual(visualIndex() - 1));
      nextBtn?.addEventListener('click', () => scrollToVisual(visualIndex() + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => scrollToVisual(i + offset)));

      let scrollTimeout: number | undefined;
      scrollEl.addEventListener('scroll', () => {
        window.clearTimeout(scrollTimeout);
        scrollTimeout = window.setTimeout(() => {
          let visual = visualIndex();
          if (hasClones && visual === 0) {
            visual = realCount;
            scrollToVisual(visual, false);
          } else if (hasClones && visual === realCount + 1) {
            visual = 1;
            scrollToVisual(visual, false);
          }
          const real = ((visual - offset) % realCount + realCount) % realCount;
          setActive(real);
        }, 100);
      });

      // start on the first real slide (past the leading clone)
      if (offset) scrollEl.scrollLeft = width() * offset;
      setActive(0);
    }
  }
</script>
