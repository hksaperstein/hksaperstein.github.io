---
const HOBBIES = [
  { name: 'Skiing', detail: 'Winters.' },
  { name: 'Golf', detail: 'Summers.' },
  { name: 'Boston sports', detail: "The Sox, B's, and Pats — usually on while I work." },
  { name: 'Maker YouTube', detail: "Adam Savage's Tested, Jeremy Fielding, StuffMadeHere." },
  { name: 'Science YouTube', detail: "Veritasium, Smarter Every Day — there's always something new to learn." },
  { name: 'Games & consumer tech', detail: 'The rest of the background noise.' },
];
---

<section id="hobbies" class="scroll-mt-16 border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-2xl font-bold tracking-tight">Off the clock</h2>
    <p class="mt-2 text-muted">When I step away from a project I tend to be very active — and when I'm at the desk, something's always playing in the background.</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        HOBBIES.map((hobby) => (
          <div class="rounded-2xl border border-line bg-card p-5">
            <h3 class="font-semibold tracking-tight">{hobby.name}</h3>
            <p class="mt-2 text-sm text-muted">{hobby.detail}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
