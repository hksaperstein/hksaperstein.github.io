---
import { getCollection } from 'astro:content';
import ProjectPreviewDialog from './ProjectPreviewDialog.astro';
import { previewDialogId } from '../lib/previewDialog';

const [featured] = await getCollection('projects', (p) => p.data.featured);
const dialogId = featured ? previewDialogId('featured', featured.id) : undefined;
---

{
  featured && (
    <section class="reveal mx-auto max-w-5xl px-6 pb-20">
      <p class="mb-4 text-sm font-medium tracking-widest text-accent uppercase">Current project</p>
      <a
        href={`/projects/${featured.id}/`}
        data-preview-trigger
        data-dialog-id={dialogId}
        class="group block overflow-hidden rounded-2xl border border-line bg-card transition-transform duration-150 hover:-translate-y-0.5 hover:border-accent motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:grid sm:grid-cols-2"
      >
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="h-full w-full object-cover"
          src="/assets/videos/projects/franka-dice-pick/dice_pick_d20.mp4"
        />
        <div class="p-8">
          <div class="flex flex-wrap gap-2">
            {featured.data.categories.map((category) => (
              <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{category}</span>
            ))}
          </div>
          <h3 class="mt-4 text-2xl font-bold tracking-tight group-hover:text-accent">{featured.data.title}</h3>
          <p class="mt-3 text-muted">{featured.data.description}</p>
        </div>
      </a>
      <ProjectPreviewDialog project={featured} idPrefix="featured" />
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((video) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
      video.setAttribute('controls', '');
    }

    // The video sits inside the whole-card preview trigger; once it has native
    // controls (reduced-motion fallback above), clicks on those controls
    // shouldn't also open the preview dialog.
    video.addEventListener('click', (event) => {
      if (video.hasAttribute('controls')) {
        event.stopPropagation();
      }
    });
  });
</script>
