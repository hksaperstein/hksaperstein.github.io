---
import { SITE } from '../data/site';
---

<section class="mx-auto max-w-5xl px-6 pt-24 pb-20 sm:pt-28">
  <div class="grid gap-8 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-x-10">
    <div class="text-center sm:text-left">
      <h1 class="enter text-4xl font-bold tracking-tight sm:text-6xl" style="--enter: 1">Harrison Saperstein</h1>
      <p class="enter mt-3 text-sm font-medium tracking-widest text-accent uppercase" style="--enter: 2">Robotics Engineer · AI Forward</p>
      <p class="enter mt-4 text-lg text-muted sm:max-w-xl" style="--enter: 2">
        Senior Software Verification Engineer at Medtronic, specialized in surgical robotic
        software. Outside of work, I'm building an RL pipeline from data generation in Blender
        through training in NVIDIA's Isaac Lab. Along the way, I'm exploring agentic
        architectures and solution development.
      </p>
    </div>
    <div class="enter-origin justify-self-center sm:col-start-2 sm:row-start-1 sm:row-span-2">
      <img
        src="/assets/images/personal/headshot-cutout.png"
        alt="Harrison Saperstein"
        width="240"
        height="240"
        class="h-48 w-48 object-cover sm:h-60 sm:w-60 [mask-image:linear-gradient(to_bottom,black_75%,transparent_100%)]"
      />
    </div>
    <div class="enter flex flex-wrap justify-center gap-3 sm:col-start-1 sm:row-start-2 sm:justify-start" style="--enter: 3">
      <a
        href={SITE.resume}
        download={SITE.resumeFilename}
        class="rounded-md bg-accent px-4 py-2 font-medium text-white transition-opacity hover:opacity-90"
      >Resume</a>
      <a href={SITE.github} class="rounded-md border border-line px-4 py-2 font-medium transition-colors hover:border-accent hover:text-accent">GitHub</a>
      <a href={SITE.linkedin} class="rounded-md border border-line px-4 py-2 font-medium transition-colors hover:border-accent hover:text-accent">LinkedIn</a>
    </div>
  </div>
</section>
