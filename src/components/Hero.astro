---
import { SITE } from '../data/site';
---

<section class="mx-auto max-w-5xl px-6 pt-24 pb-20 sm:pt-28">
  <div class="grid gap-10 sm:grid-cols-[auto_1fr] sm:items-center">
    <div>
      <p class="enter text-sm font-medium tracking-widest text-accent uppercase" style="--enter: 2">Robotics Engineer</p>
      <h1 class="enter mt-3 text-4xl font-bold tracking-tight sm:text-6xl" style="--enter: 1">Harrison Saperstein</h1>
      <p class="enter mt-4 max-w-xl text-lg text-muted" style="--enter: 2">Projects and Problems</p>
      <div class="enter mt-8 flex flex-wrap gap-3" style="--enter: 3">
        <a
          href={SITE.resume}
          download={SITE.resumeFilename}
          class="rounded-md bg-accent px-4 py-2 font-medium text-white transition-opacity hover:opacity-90"
        >Resume</a>
        <a href={SITE.github} class="rounded-md border border-line px-4 py-2 font-medium transition-colors hover:border-accent hover:text-accent">GitHub</a>
        <a href={SITE.linkedin} class="rounded-md border border-line px-4 py-2 font-medium transition-colors hover:border-accent hover:text-accent">LinkedIn</a>
      </div>
    </div>
    <div class="enter-origin justify-self-center sm:justify-self-center">
      <img
        src="/assets/images/personal/headshot.jpeg"
        alt="Harrison Saperstein"
        width="240"
        height="240"
        class="h-48 w-48 -scale-x-100 rounded-2xl border border-line object-cover sm:h-60 sm:w-60"
      />
    </div>
  </div>
</section>
