---
const HOBBIES = [
  { name: 'Winters', detail: 'Skiing.' },
  { name: 'Summers', detail: 'Golf and a rec softball league.' },
  { name: 'Boston sports', detail: "The Sox, Pats, B's and C's." },
  { name: 'Maker YouTube', detail: "Adam Savage's Tested, Jeremy Fielding, StuffMadeHere, Nerdforge, Alec Steele." },
  { name: 'Science YouTube', detail: 'Veritasium, Smarter Every Day.' },
  { name: 'Tech YouTube', detail: 'Linus Tech Tips, MKBHD, JayzTwoCents.' },
];
---

<section id="about" class="border-t border-line">
  <div class="reveal mx-auto max-w-5xl px-6 py-20">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight">About</h2>
      <div class="mt-5 space-y-4 text-muted">
        <p>
          Hi, I'm Harrison (Harry) Saperstein. I graduated from WPI with my MS/BS in Robotics
          Engineering in 2021, and somewhere between solving the kinematics of a serial
          manipulator and watching it actually move, I was hooked for good.
        </p>
        <p>
          I verify software for a surgical robot at work. On my own time I build the projects
          on this page - RL, perception, control, whatever I'm chasing this month. I like
          solving problems and making robots move, and I want to keep getting better at both.
        </p>
      </div>
    </div>

    <div class="mt-12">
      <h3 class="text-xl font-bold tracking-tight">Off the clock</h3>
      <p class="mt-2 text-muted">What I'm into when I'm not building.</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          HOBBIES.map((hobby) => (
            <div class="rounded-2xl border border-line bg-card p-5">
              <h4 class="font-semibold tracking-tight">{hobby.name}</h4>
              <p class="mt-2 text-sm text-muted">{hobby.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
